<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>MicroinvestConvert.App</RootNamespace>
    <AssemblyName>MicroinvestConvert</AssemblyName>
    <AssemblyTitle>Microinvest Конвертор</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>bg;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroinvestConvert.Core\MicroinvestConvert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MicroinvestConvert.Tests" />
  </ItemGroup>

</Project>
